#!/bin/sh
# フックを、python の在り処を気にせず起動する。
#
# **必ず 0 で戻る。** フックはユーザーの作業を止めてはならない（CLAUDE.md「Fail-Open」）。
# rb 本体と方針が違うのは、フックが「注意を出すだけ」であり、出せなかったことが
# 作業の成否に影響しないためである。
#
# **exec しない。** exec すると hooks/*.py の非ゼロ（古い python の SyntaxError、
# MemoryError 等）がそのままフックの終了コードになり、この約束が破れる。
# PreToolUse の非ゼロは stderr がユーザーへ提示されるので、Bash を叩くたびに
# traceback が出続けることになる。プロセス 1 つ分より約束を守るほうが上位である。
set -u

name=${1:-}
case "$name" in
    "" | *[!a-z0-9_]*) exit 0 ;;
esac

here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
posix_script="$here/hooks/$name.py"
[ -f "$posix_script" ] || exit 0

# フックは stdlib のみなので古い python でも動く。版は問わない。
for py in py python3 python; do
    path=$(command -v "$py" 2>/dev/null) || continue
    [ -s "$path" ] || continue
    script=$posix_script
    # Git Bash から Windows の python を呼ぶとき、POSIX パスは開けない。通常は MSYS の
    # argv 変換が効くが、MSYS2_ARG_CONV_EXCL を設定している環境では効かない。
    #
    # **変換するのは Windows ネイティブの python を選んだときだけ。** cygpath の有無で
    # 決めると、Cygwin / MSYS2(msys) の POSIX python にも Windows パスを渡してしまう。
    # そちらは受け取ったパスを区切りの無い 1 要素として扱うため、sys.path が壊れる。
    # 見分けは在り処でつく。POSIX ネイティブの実行体はエミュレーション根（/usr, /bin）に
    # あり、ドライブ経由（/c/...）や /mingw64 から見えるものは Windows ネイティブである。
    # sys.platform を聞けば確実だが、python の起動が 1 回増える。フックは毎ターン走る。
    # （bin/rb は版を聞くために既に 1 回起動しているので、あちらは確実な方を採っている。）
    case "$path" in
        /usr/* | /bin/* | /sbin/*) ;;
        *)
            if command -v cygpath >/dev/null 2>&1; then
                script=$(cygpath -w "$script") || script=$posix_script
            fi
            ;;
    esac
    "$py" "$script" || true
    exit 0
done
exit 0
