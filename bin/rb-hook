#!/bin/sh
# フックを、python の在り処を気にせず起動する。
#
# **必ず 0 で戻る。** フックはユーザーの作業を止めてはならない（CLAUDE.md「Fail-Open」）。
# rb 本体と方針が違うのは、フックが「注意を出すだけ」であり、出せなかったことが
# 作業の成否に影響しないためである。
#
# **exec しない。** exec すると hooks/*.py の非ゼロ（古い python の SyntaxError、
# MemoryError 等）がそのままフックの終了コードになり、この約束が破れる。
# PreToolUse の非ゼロは stderr がユーザーへ提示されるので、Bash を叩くたびに
# traceback が出続けることになる。プロセス 1 つ分より約束を守るほうが上位である。
set -u

name=${1:-}
case "$name" in
    "" | *[!a-z0-9_]*) exit 0 ;;
esac

here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
script="$here/hooks/$name.py"
[ -f "$script" ] || exit 0

# Git Bash から Windows の python を呼ぶとき、POSIX パスは開けない。通常は MSYS の
# argv 変換が効くが、MSYS2_ARG_CONV_EXCL を設定している環境では効かない。
if command -v cygpath >/dev/null 2>&1; then
    script=$(cygpath -w "$script") || exit 0
fi

# **Git Bash では日本語が化ける。** Windows の Python は既定でコンソールの
# コードページ（cp932 等）で書くが、Git Bash の端末は UTF-8 である。実測で確認した。
# sh から呼ばれる経路だけ UTF-8 を強制する（cmd 側は触らない。cp932 のコンソールで
# UTF-8 を強制すると、そちらが化ける）。
PYTHONUTF8=1
export PYTHONUTF8

# フックは stdlib のみなので古い python でも動く。版は問わない。
for py in py python3 python; do
    path=$(command -v "$py" 2>/dev/null) || continue
    [ -s "$path" ] || continue
    "$py" "$script" || true
    exit 0
done
exit 0
