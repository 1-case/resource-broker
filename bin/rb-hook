#!/bin/sh
# フックを、python の在り処を気にせず起動する。
#
# 直に `python hooks/xxx.py` と書けない理由が 2 つある。macOS には `python` が無い
# ことがあり（`python3` だけ）、Windows では `python3` が無い。ここで吸収する。
#
# **失敗しても 0 で戻る。** フックはユーザーの作業を止めてはならない
# （CLAUDE.md「Fail-Open」）。`rb` 本体と方針が違うのは、フックが「注意を出すだけ」で
# あり、出せなかったことが作業の成否に影響しないためである。
set -u

name=${1:-}
if [ -z "$name" ]; then
    exit 0
fi

here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
script="$here/hooks/$name.py"
[ -f "$script" ] || exit 0

for py in python3 python py; do
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$script"
    fi
done
exit 0
