#!/bin/sh
# resource-broker の CLI を、インストール無しで起動する。
#
# **python が見つからないときに 0 を返さない。** `rb run` は「走らなかったジョブを
# 成功と報告しない」という規約を持つ。ここで 0 を返すと、コマンドを 1 度も起動して
# いないのに成功として扱われる。
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || {
    echo "rb: 自分の場所を特定できません" >&2
    exit 127
}
posix_script="$here/bin/rb.py"

# 探索順は bin/ の 4 本すべてでそろえる。**py を先に試す**のは Windows のためである。
# Windows は %LOCALAPPDATA%\Microsoft\WindowsApps\ に python.exe / python3.exe の
# App Execution Alias（0 バイトの実体）を置き、PATH に載せている。command -v は
# 成功するが、起動すると Microsoft Store が開いて 9009 で終わる。サイズで弾く。
# **「見つかった最初の python」ではなく「使える python」を選ぶ。** 別プロジェクトの venv が
# 有効だと python3 がそちらに解決される（実測: WSL で ~/django-mfa/.venv の 3.10 に当たった）。
# 版付きの名前も候補に入れ、実際に 3.11 以上かを聞いてから採用する。
for py in py python3.13 python3.12 python3.11 python3 python; do
    path=$(command -v "$py" 2>/dev/null) || continue
    [ -s "$path" ] || continue
    # 版と一緒に sys.platform も聞く。**起動は 1 回のままである。**
    plat=$("$py" -c 'import sys; print(sys.platform if sys.version_info >= (3, 11) else "")' 2>/dev/null) || continue
    [ -n "$plat" ] || continue
    # ${1+"$@"} を使う。macOS の /bin/sh は bash 3.2 で、set -u 下の "$@" が
    # 引数 0 個のとき unbound variable になる（`rb` だけ打つと落ちる）。
    # Git Bash から Windows の python を呼ぶとき、POSIX パスは開けない。通常は MSYS の
    # argv 変換が効くが、MSYS2_ARG_CONV_EXCL を設定している環境では効かない。
    #
    # **変換するのは Windows ネイティブの python を選んだときだけ。** cygpath の有無で
    # 決めると、Cygwin / MSYS2(msys) の POSIX python にも Windows パスを渡してしまう。
    # そちらはバックスラッシュを区切りとみなさないので sys.path が壊れる。
    # ここは版を聞くついでに sys.platform も受け取っているので、推測する必要が無い。
    script=$posix_script
    if [ "$plat" = win32 ] && command -v cygpath >/dev/null 2>&1; then
        script=$(cygpath -w "$posix_script") || script=$posix_script
    fi
    exec "$py" "$script" ${1+"$@"}
done

echo "rb: python が見つかりません（resource-broker は Python 3.11 以上を必要とします）" >&2
exit 127
